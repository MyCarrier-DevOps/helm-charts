{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*)?$"
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environments"
        ],
        "properties": {
          "id": {},
          "environments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "transactions": {
            "type": "boolean"
          },
          "quota": {
            "type": "object"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {},
                "partitions": {
                  "type": "integer",
                  "minimum": 1
                },
                "retentionMs": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "whitelist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ips"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ips": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(/([1-9]|[12][0-9]|3[0-2]))?$"
            }
          }
        }
      }
    }
  }
}
