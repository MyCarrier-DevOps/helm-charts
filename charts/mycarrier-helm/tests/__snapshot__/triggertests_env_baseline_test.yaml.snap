        "UseDefaultNodeAffinity": "false",
        "SpreadAcrossNodes": "true",
        "PodResources": {"limits":{"cpu":"2000m","memory":"4Gi"},"requests":{"cpu":"250m","memory":"1Gi"}},
        "TestEnvironmentVariables": {
            "EnvironmentName": "dev",
