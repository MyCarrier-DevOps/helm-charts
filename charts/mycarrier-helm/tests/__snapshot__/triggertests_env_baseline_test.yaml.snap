            "ResultsApiKey": "vault:DevOps/data/autotestresults_api/api#key"
          }
        }' "$TESTENGINEHOOK_URL" || {
        rc=$?
        echo "ERROR: TestEngine trigger failed for "'apitests'" (curl exit $rc)" >&2
        failed=$((failed+1))
      }
      curl -sS --fail-with-body -w '\nTestEngine HTTP status: %{http_code}\n' \
      --max-time 60 \
      -X POST \
      -H "Content-Type: application/json" \
      -H "Authorization: $TESTENGINE_APIKEY" \
      -d '{
        "IsMonolith": false,
        "TestName": "uitests",
        "StackName": "mycarrier",
        "ContainerImage": "testing/mycarrier/api/uitests",
        "ContainerTag": "2.0.0",
        "HardenedSecurityContext": true,
        "TestFilters": ["TestCategory=UI"],
        "Tolerations": [{"effect":"NoSchedule","key":"workload","operator":"Equal","value":"tests"}],
        "NodeAffinity": [{"key":"kubernetes.azure.com/agentpool","operator":"In","values":["testpool"]}],
        "UseDefaultNodeAffinity": "false",
        "SpreadAcrossNodes": "true",
        "PodResources": {"limits":{"cpu":"2000m","memory":"4Gi"},"requests":{"cpu":"250m","memory":"1Gi"}},
        "TestEnvironmentVariables": {
            "EnvironmentName": "dev",
            "ReleaseId": "1.0.0",
            "SecretId": "vault:QA/data/app_auth#SecretId",
            "ServiceAddress": "http://mycarrier-api.dev.svc.cluster.local:8080",
            "ReleaseDefinitionName": "mycarrier-api",
            "BranchName": "main",
            "AdditionalEnvVars": "a=b;c=d",
            "CorrelationId": "corr-1",
            "LegacyMode": "false",
            "ResultsApiUrl": "vault:QA/data/autotestresults_api#url",
            "ResultsApiKey": "vault:DevOps/data/autotestresults_api/api#key"
          }
        }' "$TESTENGINEHOOK_URL" || {
        rc=$?
        echo "ERROR: TestEngine trigger failed for "'uitests'" (curl exit $rc)" >&2
        failed=$((failed+1))
      }
      if [ "$failed" -gt 0 ]; then
        echo "ERROR: $failed TestEngine trigger call(s) failed — see above; exiting 0 to avoid ArgoCD sync retries" >&2
      fi
      exit 0
